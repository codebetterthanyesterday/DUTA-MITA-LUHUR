# Environment variables template for Prisma & App

DATABASE_URL="postgresql://postgres:password@localhost:5432/deemel_db?schema=public"

# Authentication (NextAuth v5)
# Used to obscure the admin panel. E.g. setting this to "portal-9x2k" means the login is at /portal-9x2k/login
ADMIN_ROUTE_SLUG="portal-9x2k"
AUTH_SECRET="long-random-string-placeholder-for-nextauth"

# Admin Seeding (One-time only, can be removed after successful seed)
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="changeme"
NEXT_PUBLIC_SITE_URL="https://dutamitraluhur.com" # Example production domain
